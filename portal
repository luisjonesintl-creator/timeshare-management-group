<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Owner Portal Login | Timeshare Management Group</title>
    <!-- Motor nativo oficial de Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Fuentes corporativas modernas -->
    <link rel="preconnect" href="https://googleapis.com">
    <link rel="preconnect" href="https://gstatic.com" crossorigin>
    <link href="https://googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
    </style>
</head>
<body class="bg-slate-900 text-white antialiased min-h-screen flex flex-col justify-between selection:bg-blue-500/20">

    <!-- BARRA DE INFORMACIÓN CORPORATIVA -->
    <div class="bg-slate-950 text-slate-400 text-[11px] font-bold py-2 px-6 border-b border-slate-800/60">
        <div class="max-w-7xl mx-auto flex justify-between items-center">
            <span class="flex items-center"><span class="h-1.5 w-1.5 bg-cyan-400 rounded-full mr-1.5 animate-pulse"></span> SECURE AES-256 ENCRYPTED PORTAL</span>
            <a href="index.html" class="hover:text-white transition-colors text-[10px] uppercase tracking-wider">&larr; Back to Marketplace</a>
        </div>
    </div>

    <!-- CONTENEDOR PRINCIPAL DEL ACCESO -->
    <main class="flex-grow flex items-center justify-center px-4 py-16 relative overflow-hidden">
        <!-- Luces ambientales de fondo -->
        <div class="absolute top-1/4 left-1/4 w-80 h-80 bg-blue-600/10 rounded-full blur-3xl animate-pulse"></div>
        <div class="absolute bottom-1/4 right-1/4 w-80 h-80 bg-cyan-500/10 rounded-full blur-3xl animate-pulse delay-700"></div>

        <div class="relative w-full max-w-md bg-slate-950/40 border border-slate-800/80 rounded-3xl p-8 backdrop-blur-xl shadow-2xl space-y-6">
            
            <!-- Identidad Corporativa -->
            <div class="text-center space-y-2">
                <div class="inline-block bg-gradient-to-tr from-blue-900 via-blue-950 to-blue-800 text-white p-3 rounded-2xl font-black tracking-wider text-2xl shadow-md mb-2">TMG</div>
                <h1 class="text-2xl font-black text-white tracking-tight">Owner Management Portal</h1>
                <p class="text-slate-400 text-xs font-medium">Access your timeshare intervals, points management feed and active purchase offers.</p>
            </div>

            <!-- Formulario de Acceso -->
            <form id="portal-login-form" class="space-y-4">
                <div>
                    <label for="owner-email" class="block text-[10px] font-black uppercase tracking-widest text-slate-400 mb-1.5">Account Email</label>
                    <input type="email" id="owner-email" required placeholder="name@example.com" class="w-full p-3.5 border border-slate-800 rounded-xl bg-slate-900/60 text-white text-sm focus:outline-none focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 transition-all font-medium placeholder-slate-600">
                </div>
                
                <div>
                    <div class="flex justify-between items-center mb-1.5">
                        <label for="owner-password" class="block text-[10px] font-black uppercase tracking-widest text-slate-400">Password</label>
                        <a href="#" class="text-[10px] text-cyan-400 hover:underline font-bold">Forgot password?</a>
                    </div>
                    <input type="password" id="owner-password" required placeholder="••••••••" class="w-full p-3.5 border border-slate-800 rounded-xl bg-slate-900/60 text-white text-sm focus:outline-none focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 transition-all font-medium placeholder-slate-600">
                </div>

                <div class="flex items-center space-x-2 pt-1">
                    <input type="checkbox" id="remember-me" class="h-4 w-4 rounded border-slate-800 bg-slate-900 text-blue-600 focus:ring-0 cursor-pointer">
                    <label for="remember-me" class="text-slate-400 text-xs font-semibold select-none cursor-pointer">Keep me logged in for 30 days</label>
                </div>
                <button type="submit" class="w-full bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 text-white font-bold text-xs uppercase tracking-wider py-4 rounded-xl transition-all shadow-lg shadow-blue-900/20 mt-2">
                    Secure Account Login
                </button>
            </form>

            <!-- Mensaje Informativo o de Alerta Simulada -->
            <div id="portal-alert" class="hidden text-center text-xs font-semibold p-3.5 rounded-xl border"></div>

            <!-- Bloque de Seguridad Corporativa -->
            <div class="border-t border-slate-800/80 pt-4 text-center">
                <p class="text-[10px] text-slate-500 font-medium leading-normal">
                    🔒 **Verification Notice:** Timeshare Management Group will never ask for your account password or upfront closing costs via phone or email.
                </p>
            </div>
        </div>
    </main>

    <!-- PIE DE PÁGINA SIMPLIFICADO -->
    <footer class="bg-slate-950 text-slate-600 text-[10px] font-bold py-6 text-center border-t border-slate-900/60">
        &copy; 2003-2026 Timeshare Management Group, LLC. All rights reserved. | AES-256 Verified
    </footer>

    <!-- INTERACCIÓN DEL PORTAL SIMULADO -->
    <script>
        document.getElementById('portal-login-form').addEventListener('submit', function(e) {
            e.preventDefault();
            
            const email = document.getElementById('owner-email').value;
            const alertBox = document.getElementById('portal-alert');
            
            // Simulación rápida de validación interactiva corporativa
            alertBox.classList.remove('hidden', 'bg-rose-500/10', 'text-rose-400', 'border-rose-500/20', 'bg-emerald-500/10', 'text-emerald-400', 'border-emerald-500/20');
            
            if (email.includes('test')) {
                alertBox.innerText = "❌ Security Demo Account Active. Access Granted.";
                alertBox.classList.add('block', 'bg-emerald-500/10', 'text-emerald-400', 'border-emerald-500/20');
            } else {
                alertBox.innerText = "⚠️ Demo Portal Notice: Verification link sent to " + email;
                alertBox.classList.add('block', 'bg-blue-500/10', 'text-cyan-400', 'border-blue-500/20');
            }
        });
    </script>
</body>
</html>
